<?xml version='1.0' encoding='UTF-8'?><magicdraw><enumeration id="_19_0_4_c480314_1686218566177_695852_6852" refElementId="_19_0_4_c480314_1686218566177_695852_6852" humanType="Enumeration" classType="Enumeration" requireSort="node" icon="Mboe_WebPub2_Export_files/icon_enumeration_604893842.jpg"><documentation humanName="Documentation" mode="s">The MVF Spec does not dictate what values should be adopted for entry status. The enumerated values here are based on the idea that a term goes through the following life-cycle (in order):
DICTIONARY_DEF - a term is in use in a context but no formal definition of the corresponding concept  has been proposed or adopted for the relevant context, relying on dictionary definitions
PROPOSED - term and definition have been proposed but not approved
DRAFT - a term and definition have been provisionally accepted, subject to an approval process
PUBLISHED - term and definition are approved and published in an official document (note: considered as official in the context, may not be official in other contexts)
WITHDRAWN - term no longer in use i.e. officially withdrawn This possibly duplicates isDeprecated in some contexts, but not necessarily - for example a concept from a standard may remain in use on a project after the standard is withdrawn because it was current when the product was developed.</documentation><visibility humanName="Visibility" mode="s,e">public</visibility><qualifiedName humanName="Qualified Name" mode="e">MBOE::MVF for MBOE::MVF Profile::VocabularyEntryStatus</qualifiedName><package refid="_19_0_4_c480314_1686178570431_519837_5351" refElementId="_19_0_4_c480314_1686178570431_519837_5351" humanType="Profile" classType="Profile" name="MVF Profile" hasDiagram="true" icon="Mboe_WebPub2_Export_files/icon_profile_547512166.jpg" humanName="Package"/><owningPackage refid="_19_0_4_c480314_1686178570431_519837_5351" refElementId="_19_0_4_c480314_1686178570431_519837_5351" humanType="Profile" classType="Profile" name="MVF Profile" hasDiagram="true" icon="Mboe_WebPub2_Export_files/icon_profile_547512166.jpg" humanName="Owning Package"/><owner refid="_19_0_4_c480314_1686178570431_519837_5351" refElementId="_19_0_4_c480314_1686178570431_519837_5351" humanType="Profile" classType="Profile" name="MVF Profile" hasDiagram="true" icon="Mboe_WebPub2_Export_files/icon_profile_547512166.jpg" humanName="Owner" mode="s,e"/><ownedMember humanName="Owned Member"><enumerationliteral refid="_19_0_4_c480314_1691162317454_351668_12137" refElementId="_19_0_4_c480314_1691162317454_351668_12137" humanType="Enumeration Literal" classType="EnumerationLiteral" name="undefined" icon="Mboe_WebPub2_Export_files/icon_enumerationliteral_2034527055.jpg"/><enumerationliteral refid="_19_0_4_c480314_1686218757958_277050_6878" refElementId="_19_0_4_c480314_1686218757958_277050_6878" humanType="Enumeration Literal" classType="EnumerationLiteral" name="DICTIONARY_DEF" icon="Mboe_WebPub2_Export_files/icon_enumerationliteral_2034527055.jpg"/><enumerationliteral refid="_19_0_4_c480314_1686218815518_8