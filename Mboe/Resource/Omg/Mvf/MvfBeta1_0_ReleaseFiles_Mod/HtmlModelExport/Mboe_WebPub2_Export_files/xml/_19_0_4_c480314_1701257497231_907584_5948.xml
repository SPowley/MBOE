<?xml version='1.0' encoding='UTF-8'?><magicdraw><diagram id="_19_0_4_c480314_1701257497231_907584_5948" refElementId="_19_0_4_c480314_1701257497231_907584_5948" humanType="Diagram" classType="Diagram" requireSort="node" icon="Mboe_WebPub2_Export_files/icon_Class Diagram_1186933853.jpg" diagramType="Class Diagram" src="Mboe_WebPub2_Export_files/_19_0_4_c480314_1701257497231_907584_5948.jpg"><documentation humanName="Documentation" mode="s">&lt;html>
